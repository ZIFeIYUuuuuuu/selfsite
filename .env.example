# Shared / Infra
COMPOSE_PROJECT_NAME=selfsite
CADDY_HTTP_PORT=8080

# Frontend
NEXT_PUBLIC_SITE_NAME=子非鱼
BACKEND_ORIGIN=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1

# Optional public contact UI (set privately in frontend/.env.production.local)
# These values are visible to website visitors when enabled. Never commit real contacts.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_QQ_ENABLED=false
NEXT_PUBLIC_CONTACT_WECHAT_ENABLED=false
# Upload QR files directly to frontend/public/contact/; this directory is ignored.

# Backend
APP_NAME=selfsite-backend
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/selfsite
REDIS_URL=redis://redis:6379/0

# Database
POSTGRES_DB=selfsite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
